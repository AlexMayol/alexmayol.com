---
import '@fontsource-variable/fraunces';
import frauncesLatinUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import { SITE } from '../data/site';
import type { Lang } from '../i18n/routes';
import type { TransitionAnimation, TransitionDirectionalAnimations } from 'astro';

// Astro's stock slide ends too abruptly; same slide with easeInOutSine —
// near-linear motion with soft ends. Keyframes live in global.css.
const anim = (name: string): TransitionAnimation => ({
  name,
  duration: '500ms',
  easing: 'cubic-bezier(0.37, 0, 0.63, 1)',
  fillMode: 'both',
});
const slide: TransitionDirectionalAnimations = {
  forwards: {
    old: [anim('vtFadeOut'), anim('vtSlideToLeft')],
    new: [anim('vtFadeIn'), anim('vtSlideFromRight')],
  },
  backwards: {
    old: [anim('vtFadeOut'), anim('vtSlideToRight')],
    new: [anim('vtFadeIn'), anim('vtSlideFromLeft')],
  },
};

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternate: { en: string; es: string };
  ogType?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  lang,
  title,
  description,
  alternate,
  ogType = 'website',
  ogImage = '/og.png',
  jsonLd,
} = Astro.props;
const abs = (path: string) => new URL(path, Astro.site).href;
---

<html lang={lang} class="scrollbar-gutter-stable">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" as="font" type="font/woff2" href={frauncesLatinUrl} crossorigin />
    <link rel="canonical" href={abs(alternate[lang])} />
    <link rel="alternate" hreflang="en" href={abs(alternate.en)} />
    <link rel="alternate" hreflang="es" href={abs(alternate.es)} />
    <link rel="alternate" hreflang="x-default" href={abs(alternate.en)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={abs(alternate[lang])} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:site_name" content={SITE.displayName} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#FAF8F5" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <ClientRouter />
  </head>
  <body class="min-h-dvh bg-paper font-sans text-ink antialiased">
    <Header lang={lang} alternate={alternate} />
    <main transition:name="main" transition:animate={slide}><slot /></main>
    <script>
      import type {
        TransitionBeforePreparationEvent,
        TransitionBeforeSwapEvent,
      } from 'astro:transitions/client';
      import { routes } from '../i18n/routes';

      const norm = (path: string) => (path.endsWith('/') ? path : `${path}/`);

      // Slide direction follows nav order (home < experience < freelancing <
      // log < contact) instead of browser history: navigating to a page
      // further right in the nav slides forward, further left slides back.
      const sectionOrder = ['experience', 'freelancing', 'log', 'contact'] as const;
      const prefixes = sectionOrder.flatMap((key, i) =>
        (['en', 'es'] as const).map((l) => [routes[key][l], i + 1] as const)
      );
      const order = (path: string) =>
        prefixes.find(([prefix]) => norm(path).startsWith(prefix))?.[1] ?? 0;

      // Drill-down navigations (listing → post, home → section) zoom+fade
      // instead of sliding, and shared texts morph: both documents get tagged
      // with data-vt so the html[data-vt=…] rules in global.css out-specify
      // the slide on main and name the morphing elements.
      const postPrefixes = [routes.log.en, routes.log.es];
      const isPost = (path: string) => {
        const p = norm(path);
        return postPrefixes.some((prefix) => p.startsWith(prefix) && p.length > prefix.length);
      };
      const isHome = (path: string) => {
        const p = norm(path);
        return p === routes.home.en || p === routes.home.es;
      };
      const depth = (path: string) => (isHome(path) ? 0 : isPost(path) ? 2 : 1);
      const vtKind = (fromPath: string, toPath: string) => {
        const d = depth(toPath) - depth(fromPath);
        return d > 0 ? 'zoom-in' : d < 0 ? 'zoom-out' : undefined;
      };
      const tag = (root: HTMLElement, kind: string | undefined) => {
        if (kind) root.dataset.vt = kind;
        else delete root.dataset.vt;
      };

      document.addEventListener('astro:before-preparation', (event) => {
        const e = event as TransitionBeforePreparationEvent;
        e.direction = order(e.to.pathname) < order(e.from.pathname) ? 'back' : 'forward';
        // Tag the live document HERE: the outgoing snapshots are captured
        // before astro:before-swap fires, and titles only carry their
        // view-transition-name while the document is tagged.
        tag(document.documentElement, vtKind(e.from.pathname, e.to.pathname));
      });

      document.addEventListener('astro:before-swap', (event) => {
        const e = event as TransitionBeforeSwapEvent;
        tag(e.newDocument.documentElement, vtKind(e.from.pathname, e.to.pathname));
      });
    </script>
  </body>
</html>
