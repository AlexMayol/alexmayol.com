---
import { routes, otherLang, type Lang } from '../i18n/routes';
import { ui } from '../i18n/ui';
import { SITE } from '../data/site';

interface Props {
  lang: Lang;
  alternate: { en: string; es: string };
}

const { lang, alternate } = Astro.props;
const t = ui[lang].nav;
const other = otherLang(lang);
const toggleLabel = other === 'es' ? 'Ver esta página en español' : 'View this page in English';

const links = [
  [routes.experience[lang], t.experience],
  [routes.freelancing[lang], t.freelancing],
  [routes.log[lang], t.log],
  [routes.contact[lang], t.contact],
] as const;

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const home = routes.home[lang];
const isCurrent = (href: string) =>
  href === home ? path === href : path.startsWith(href);
const linkClass = (href: string) =>
  isCurrent(href) ? 'text-accent' : 'hover:text-accent';
const langClass =
  'inline-flex min-h-11 min-w-11 items-center justify-center rounded border border-ink/20 px-3 text-sm font-semibold tracking-wide uppercase hover:border-accent hover:text-accent';
---

<header transition:name="header" class="sticky top-0 z-10 border-b border-ink/10 bg-paper/90 backdrop-blur">
  <nav class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4" aria-label="Main">
    <a
      href={home}
      class:list={['font-display text-lg font-semibold', isCurrent(home) && 'text-accent']}
      aria-current={isCurrent(home) ? 'page' : undefined}
    >{SITE.displayName}</a>

    <div class="hidden items-center gap-5 text-sm sm:flex">
      {
        links.map(([href, label]) => (
          <a href={href} class={linkClass(href)} aria-current={isCurrent(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
      <a href={alternate[other]} class={langClass} aria-label={toggleLabel}>{other}</a>
    </div>

    <div class="flex items-center gap-3 sm:hidden">
      <a href={alternate[other]} class={langClass} aria-label={toggleLabel}>{other}</a>
      <button
        popovertarget="mobile-menu"
        data-menu-btn
        aria-label={t.menu}
        aria-expanded="false"
        class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center"
      >
        <span class="t-icon-swap" data-state="a" aria-hidden="true">
          <svg
            class="t-icon"
            data-icon="a"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg
            class="t-icon"
            data-icon="b"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </span>
      </button>
    </div>

    <div
      id="mobile-menu"
      popover
      class="fixed inset-auto top-16 right-4 m-0 w-56 rounded-2xl border border-ink/10 bg-paper p-2 text-ink shadow-lg backdrop:bg-ink/10"
    >
      {
        links.map(([href, label]) => (
          <a
            href={href}
            class:list={[
              'block rounded-lg px-4 py-3 text-base hover:bg-accent/10 hover:text-accent',
              isCurrent(href) && 'text-accent',
            ]}
            aria-current={isCurrent(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const closeMenu = () => document.getElementById('mobile-menu')?.hidePopover();

  document.addEventListener('astro:before-swap', closeMenu);

  document.addEventListener('astro:page-load', () => {
    const menu = document.getElementById('mobile-menu');
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
    if (!menu || !btn) return;
    const swap = btn.querySelector<HTMLElement>('.t-icon-swap');
    const sync = () => {
      const open = menu.matches(':popover-open');
      btn.setAttribute('aria-expanded', String(open));
      if (swap) swap.dataset.state = open ? 'b' : 'a';
    };
    menu.addEventListener('toggle', sync);
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
    sync();
  });
</script>
