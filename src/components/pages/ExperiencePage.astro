---
import Base from '../../layouts/Base.astro';
import { routes, type Lang } from '../../i18n/routes';
import { ui } from '../../i18n/ui';
import { experience } from '../../data/experience';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const jobs = experience[lang];
---

<Base
  lang={lang}
  title={t.meta.experience.title}
  description={t.meta.experience.description}
  alternate={routes.experience}
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1
      data-vt-morph
      style="--vt-name: section-title-experience"
      class="font-display text-5xl font-semibold tracking-tight"
    >
      {t.experience.heading}
    </h1>
    <p data-vt-morph style="--vt-name: section-blurb-experience" class="mt-4 max-w-xl text-lg text-ink/70">
      {t.experience.intro}
    </p>
    <ol class="mt-16 space-y-16 border-l border-ink/10 pl-8">
      {jobs.map((job) => (
        <li data-reveal class="relative">
          <span class="absolute top-2 -left-[2.45rem] size-3 rounded-full bg-accent" aria-hidden="true"></span>
          <p class="text-sm tracking-wide text-ink/65 uppercase">
            {job.dates}{job.note && ` · ${job.note}`}
          </p>
          <h2 class="mt-1 font-display text-2xl font-semibold">
            {job.role} · {job.organization}
          </h2>
          <p class="mt-2 text-ink/80">{job.summary}</p>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-ink/70">
            {job.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
          <ul class="mt-4 flex flex-wrap gap-2">
            {job.skills.map((s) => (
              <li class="rounded-full border border-ink/15 px-3 py-0.5 text-xs text-ink/65">{s}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>
</Base>

<script>
  import '../../scripts/motion';
</script>
