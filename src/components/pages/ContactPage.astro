---
import Base from '../../layouts/Base.astro';
import PageGlyph from '../PageGlyph.astro';
import { routes, type Lang } from '../../i18n/routes';
import { ui } from '../../i18n/ui';
import { SITE, SOCIALS, personJsonLd } from '../../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const [emailUser, emailDomain] = SITE.email.split('@');

const cards = [
  {
    label: 'GitHub',
    handle: SOCIALS.githubHandle,
    href: SOCIALS.github,
    blurb: t.contact.github,
  },
  {
    label: 'LinkedIn',
    handle: SITE.name,
    href: SOCIALS.linkedin,
    blurb: t.contact.linkedin,
  },
  {
    label: 'Email',
    handle: SITE.email,
    href: `mailto:${SITE.email}`,
    blurb: t.contact.email,
  },
];
---

<Base
  lang={lang}
  title={t.meta.contact.title}
  description={t.meta.contact.description}
  alternate={routes.contact}
  jsonLd={personJsonLd}
>
  <div class="relative isolate">
    <PageGlyph char="@" corner="tr" />
    <section class="mx-auto max-w-3xl px-6 py-16">
      <h1 class="font-display text-5xl font-semibold tracking-tight">
        {t.contact.heading.slice(0, -1)}<span class="text-accent">.</span>
      </h1>
      <p class="mt-4 max-w-xl text-lg text-ink/70">{t.contact.intro}</p>

      <div data-stagger class="mt-14 grid gap-6 sm:grid-cols-3">
        {cards.map((card) => (
          <a
            href={card.href}
            rel={card.href.startsWith('http') ? 'me noopener' : undefined}
            class="group block rounded-xl border border-ink/10 bg-white/60 p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md"
          >
            <p class="text-sm tracking-wide text-ink/65 uppercase">{card.label}</p>
            <p class="mt-2 font-display text-xl font-semibold break-words group-hover:text-accent">
              {card.href.startsWith('mailto:') ? (
                <>
                  {emailUser}<wbr />@{emailDomain}
                </>
              ) : (
                card.handle
              )}
            </p>
            <p class="mt-3 text-sm text-ink/65">{card.blurb}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>

<script>
  import '../../scripts/motion';
</script>
