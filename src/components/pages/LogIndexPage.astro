---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageGlyph from '../PageGlyph.astro';
import { routes, type Lang } from '../../i18n/routes';
import { ui } from '../../i18n/ui';
import { getPosts, postUrl, formatDate, readingTime } from '../../lib/posts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const posts = await getPosts(lang);
---

<Base
  lang={lang}
  title={t.meta.log.title}
  description={t.meta.log.description}
  alternate={routes.log}
>
  <div class="relative isolate">
    <PageGlyph char="¶" corner="tr" />
    <section class="mx-auto max-w-3xl px-6 py-16">
      <h1 class="font-display text-5xl font-semibold tracking-tight">
        {t.log.heading}<span class="text-accent">.</span>
      </h1>
      <p class="mt-4 max-w-xl text-lg text-ink/70">{t.log.intro}</p>

      {posts.length === 0 && <p class="mt-14 text-ink/65">{t.log.empty}</p>}

      <ul class="mt-14 space-y-10">
        {posts.map((post) => (
          <li data-reveal>
            <a href={postUrl(post)} class="group block">
              <article class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
                {(post.data.cover || post.data.coverVideo) && (
                  <div class="order-first shrink-0 sm:order-last">
                    {post.data.cover && (
                      <Image
                        src={post.data.cover}
                        alt=""
                        widths={[320, 640, 768]}
                        sizes="10rem"
                        class="log-cover aspect-[3/2] w-36 rounded-xl object-cover sm:w-40"
                        data-vt-morph
                        style={`--vt-name: post-cover-${post.data.translationKey}`}
                      />
                    )}
                    {post.data.coverVideo && (
                      <video
                        src={post.data.coverVideo}
                        class="log-cover aspect-[3/2] w-36 rounded-xl object-cover sm:w-40"
                        muted
                        playsinline
                        preload="metadata"
                        data-vt-morph
                        style={`--vt-name: post-cover-${post.data.translationKey}`}
                      />
                    )}
                  </div>
                )}
                <div class="min-w-0">
                  <p class="text-sm tracking-wide text-ink/65 uppercase">
                    <span data-vt-morph style={`--vt-name: post-date-${post.data.translationKey}`}>
                      {formatDate(post, lang)}
                    </span>
                    <span data-vt-morph style={`--vt-name: post-read-${post.data.translationKey}`}>
                      {' '}· {readingTime(post)} {t.log.minRead}
                    </span>
                  </p>
                  <h2
                    data-vt-morph
                    style={`--vt-name: post-title-${post.data.translationKey}`}
                    class="mt-1 font-display text-2xl font-semibold group-hover:text-accent"
                  >
                    {post.data.title}
                  </h2>
                  <p class="mt-2 text-ink/70">{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <p
                      data-vt-morph
                      style={`--vt-name: post-tags-${post.data.translationKey}`}
                      class="mt-3 flex flex-wrap gap-x-3 text-sm text-accent"
                    >
                      {post.data.tags.map((tag) => (
                        <span>#{tag}</span>
                      ))}
                    </p>
                  )}
                </div>
              </article>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<script>
  import '../../scripts/motion';
</script>
