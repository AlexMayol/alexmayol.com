---
import '../../styles/prose.css';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { routes, type Lang } from '../../i18n/routes';
import { SITE } from '../../data/site';
import { ui } from '../../i18n/ui';
import { findTranslation, formatDate, postUrl, readingTime, type Post } from '../../lib/posts';

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = ui[lang];
const all = await getCollection('log', (p) => (import.meta.env.PROD ? !p.data.draft : true));
// Pairs are already asserted by getPosts in prod; in dev an unpaired draft
// falls back to itself so the language toggle still renders.
const pair = findTranslation(post, all) ?? post;
const alternate =
  lang === 'en'
    ? { en: postUrl(post), es: postUrl(pair) }
    : { en: postUrl(pair), es: postUrl(post) };
const { Content } = await render(post);
const hasMedia = Boolean(post.data.cover || post.data.coverVideo);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  inLanguage: lang,
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  ...(post.data.cover && { image: new URL(post.data.cover.src, Astro.site).href }),
};
---

<Base
  lang={lang}
  title={`${post.data.title} — ${SITE.displayName}`}
  description={post.data.description}
  alternate={alternate}
  ogType="article"
  ogImage={post.data.cover?.src}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <header class={hasMedia ? 'flex flex-col gap-5' : undefined}>
      <div class="min-w-0">
        <a
          href={routes.log[lang]}
          class="group mb-3 inline-flex items-center gap-1.5 text-sm text-ink/55 transition-colors hover:text-accent"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="transition-transform group-hover:-translate-x-0.5"
          >
            <path d="M19 12H5M11 18l-6-6 6-6"></path>
          </svg>
          {t.log.back}
        </a>
        <p class="text-sm tracking-wide text-ink/65 uppercase">
          <span data-vt-morph style={`--vt-name: post-date-${post.data.translationKey}`}>
            {formatDate(post, lang)}
          </span>
          <span data-vt-morph style={`--vt-name: post-read-${post.data.translationKey}`}>
            {' '}· {readingTime(post)} {t.log.minRead}
          </span>
        </p>
        <h1
          data-vt-morph
          style={`--vt-name: post-title-${post.data.translationKey}`}
          class="mt-2 font-display text-4xl font-semibold tracking-tight sm:text-5xl"
        >
          {post.data.title}
        </h1>
        <p
          data-vt-morph
          style={`--vt-name: post-desc-${post.data.translationKey}`}
          class="mt-3 text-lg text-ink/70"
        >
          {post.data.description}
        </p>
        {
          post.data.tags.length > 0 && (
            <p
              data-vt-morph
              style={`--vt-name: post-tags-${post.data.translationKey}`}
              class="mt-3 flex flex-wrap gap-x-3 text-sm text-accent"
            >
              {post.data.tags.map((tag) => (
                <span>#{tag}</span>
              ))}
            </p>
          )
        }
      </div>
      {
        post.data.cover && (
          <Image
            src={post.data.cover}
            alt={post.data.coverAlt}
            widths={[320, 640, 768]}
            sizes="(min-width: 48rem) 45rem, calc(100vw - 3rem)"
            class="aspect-[3/2] w-full rounded-xl object-cover"
            loading="eager"
            fetchpriority="high"
            data-vt-morph
            style={`--vt-name: post-cover-${post.data.translationKey}`}
          />
        )
      }
      {
        post.data.coverVideo && (
          <video
            src={post.data.coverVideo}
            class="aspect-[3/2] w-full rounded-xl object-cover"
            autoplay
            muted
            loop
            playsinline
            data-vt-morph
            style={`--vt-name: post-cover-${post.data.translationKey}`}
          />
        )
      }
    </header>
    <div class="prose mt-10">
      <Content />
    </div>
  </article>
</Base>

<script>
  import '@justinribeiro/lite-youtube';

  // Autoplaying cover videos respect reduced motion: pause and hand over controls.
  document.addEventListener('astro:page-load', () => {
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((v) => {
      v.pause();
      v.controls = true;
    });
  });
</script>
